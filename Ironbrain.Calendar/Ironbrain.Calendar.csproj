<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Ironbrain.Calendar</RootNamespace>
    <Description>CalDAV / iCalendar client for arbitrary self-hosted calendar servers (e.g. Mailcow SOGo).</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ironbrain.Calendar.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Ical.Net" Version="5.2.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.3" />
  </ItemGroup>

</Project>
