<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Ironbrain.MailCal.Mcp</RootNamespace>
    <AssemblyName>ironbrain-mailcal-mcp</AssemblyName>
    <Description>MCP stdio server (ironbrain-mailcal-mcp) for Cursor and other MCP clients — IMAP/SMTP + CalDAV. Companion CLI: Ironbrain.MailCal.Cli. Shared config ~/.config/ironbrain/mailcal.json.</Description>

    <!-- Companion .NET global tool -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ironbrain-mailcal-mcp</ToolCommandName>
    <PackageId>Ironbrain.MailCal.Mcp</PackageId>
    <Version>0.1.3</Version>
    <Authors>kern-services</Authors>
    <Company>kern-services</Company>
    <PackageTags>ironbrain;mail;imap;smtp;caldav;mcp;cursor;bot;dotnet-tool</PackageTags>
    <PackageProjectUrl>https://www.ironbrain.de/mailcal/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kern-services/ironbrain-mailcal</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
    <PackageReference Include="ModelContextProtocol" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ironbrain.MailCal\Ironbrain.MailCal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
