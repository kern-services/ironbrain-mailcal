<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Ironbrain.MailCal.Cli</RootNamespace>
    <AssemblyName>ironbrain-mailcal</AssemblyName>
    <Description>CLI (ironbrain-mailcal) for IMAP/SMTP + CalDAV against self-hosted servers. For scripts, cron, CI, and bot hosts that shell out. Companion MCP tool: Ironbrain.MailCal.Mcp. Shared config ~/.config/ironbrain/mailcal.json.</Description>

    <!-- .NET global tool -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ironbrain-mailcal</ToolCommandName>
    <PackageId>Ironbrain.MailCal.Cli</PackageId>
    <Version>0.1.3</Version>
    <Authors>kern-services</Authors>
    <Company>kern-services</Company>
    <PackageTags>ironbrain;mail;imap;smtp;caldav;ical;mailcow;bot;cli;dotnet-tool</PackageTags>
    <PackageProjectUrl>https://www.ironbrain.de/mailcal/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kern-services/ironbrain-mailcal</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.3" />
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ironbrain.MailCal\Ironbrain.MailCal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="appsettings.example.json" Pack="true" PackagePath="content\" />
    <None Update="appsettings.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
